{
  "name": "tradesource-cypress",
  "version": "1.0.0",
  "description": "cypress training",
  "license": "ISC",
  "author": "s greenwood",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run --spec cypress/e2e/regression-tests-pom.cy.ts",
    "cy:chrome": "cypress run --browser chrome",
    "cy:headed": "cypress run --headed",
    "cy:baseline": "cypress run --spec cypress/e2e/regression-tests-pom.cy.ts --env updateBaseline=true",
    "test": "cypress run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "axe-core": "^4.14.0",
    "cypress": "^16.1.1",
    "cypress-axe": "^1.7.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "dotenv": "^18.0.7",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "cypress-axe": {
      "cypress": "$cypress"
    }
  }
}
