{
  "name": "tradesource-cypress",
  "version": "1.0.0",
  "description": "cypress training",
  "license": "ISC",
  "author": "s greenwood",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run --browser chrome --spec cypress/e2e/regression-tests-pom.cy.ts",
    "cy:chrome": "cypress run --browser chrome",
    "cy:headed": "cypress run --browser chrome --headed",
    "cy:baseline": "cypress run --browser chrome --spec cypress/e2e/regression-tests-pom.cy.ts --env updateBaseline=true",
    "bdd": "cypress run --browser chrome --spec \"cypress/e2e/features/*.feature\"",
    "bdd:functional": "cypress run --browser chrome --spec \"cypress/e2e/features/functional-regression.feature\"",
    "bdd:visual": "cypress run --browser chrome --spec \"cypress/e2e/features/visual-regression.feature\"",
    "bdd:accessibility": "cypress run --browser chrome --spec \"cypress/e2e/features/accessibility.feature\"",
    "bdd:api": "cypress run --browser chrome --spec \"cypress/e2e/features/api-regression.feature\"",
    "bdd:baseline": "cypress run --browser chrome --spec \"cypress/e2e/features/visual-regression.feature\" --env updateBaseline=true",
    "test": "cypress run --browser chrome"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@types/node": "^26.6.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "axe-core": "^4.14.0",
    "cypress": "^16.1.1",
    "cypress-axe": "^1.7.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "dotenv": "^18.0.7",
    "esbuild": "^0.28.2",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "cypress-axe": {
      "cypress": "$cypress"
    }
  }
}
